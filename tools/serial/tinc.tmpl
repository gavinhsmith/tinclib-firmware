# Readable TINCLIB frames for serial-passthrough's -t option (with -p tinc.spec).
# Payload layouts follow protocol.h (tinclib-protocol v0.1.0). First matching rule wins.
# Request headers and Wi-Fi passwords are deliberately not shown.

enum type 1=HELLO 2=STATUS 16=REQ_BEGIN 17=REQ_STATUS 19=HDR_GET 20=REQ_ABORT 32=BODY_WRITE 33=BODY_READ 64=WIFI_LIST 65=WIFI_SET 66=WIFI_FORGET
enum err 0=OK 1=UNSUPPORTED 2=NO_HELLO 3=VERSION 4=BAD_LEN 5=BUSY 6=BAD_STATE 7=BAD_OFFSET 8=BAD_ARG 9=UNSUPPORTED_SCHEME 32=WIFI_DOWN 33=DNS 34=CONNECT 35=TIMEOUT 36=HTTP_PROTO 37=TOO_MANY_REDIRECTS 38=NO_MEM
enum wifi 0=NO_CREDS 1=CONNECTING 2=CONNECTED 3=FAILED
enum rs 0=IDLE 1=CONNECTING 2=TLS 3=SENDING 4=WAIT_HEADERS 5=BODY 6=DONE 7=ERROR
enum slot 255=none
enum method 1=GET
enum len 4294967295=unknown
enum eof 0=more 1=EOF

# errors (any type)
when flags=5 type=1 "#{seq} HELLO -> {code:err}, ESP is v{major}.{minor}" payload: code:u8, major:u8, minor:u8
when flags=5 "#{seq} {type:type} -> {code:err}" payload: code:u8

# HELLO
when flags=0 type=1 "#{seq} HELLO v{major}.{minor} max_payload={max}" payload: major:u8, minor:u8, caps:u16, max:u16
when flags=1 type=1 "#{seq} HELLO ok v{major}.{minor} max_payload={max} heap={heap}" payload: major:u8, minor:u8, caps:u16, max:u16, heap:u32

# STATUS
when flags=0 type=2 "#{seq} STATUS?"
when flags=1 type=2 "#{seq} STATUS wifi={wifi:wifi} slot={slot:slot} rssi={rssi} ip={a}.{b}.{c}.{d} heap={heap} req={req:rs}" payload: wifi:u8, slot:u8, rssi:i8, a:u8, b:u8, c:u8, d:u8, heap:u32, req:u8

# requests
when flags=0 type=16 "#{seq} REQ_BEGIN {method:method} {url} (flags={rflags} timeout={timeout}s headers={hdr_len}B)" payload: method:u8, rflags:u8, timeout:u8, clen:u32, url_len:u16, hdr_len:u16, url:text(url_len)
when flags=1 type=16 "#{seq} REQ_BEGIN ok"
when flags=0 type=17 "#{seq} REQ_STATUS?"
when flags=1 type=17 "#{seq} REQ_STATUS {state:rs} err={err:err} http={http} len={clen:len} type={ctype}" payload: state:u8, err:u8, http:u16, clen:u32, ctype_len:u8, ctype:text(ctype_len)
when flags=0 type=20 "#{seq} REQ_ABORT"
when flags=1 type=20 "#{seq} REQ_ABORT ok"
when flags=0 type=33 "#{seq} BODY_READ @{off} max={max} wait={wait}ms" payload: off:u32, max:u16, wait:u8
when flags=1 type=33 "#{seq} BODY @{off} {rflags:eof}: {data}" payload: off:u32, rflags:u8, data:text(*)

# Wi-Fi slots (passwords are never shown)
when flags=0 type=64 "#{seq} WIFI_LIST?"
when flags=1 type=64 "#{seq} WIFI_LIST 0=[{s0}] 1=[{s1}] 2=[{s2}]" payload: l0:u8, s0:text(l0), l1:u8, s1:text(l1), l2:u8, s2:text(l2)
when flags=0 type=65 "#{seq} WIFI_SET slot {slot} ssid={ssid} (password hidden)" payload: slot:u8, sl:u8, ssid:text(sl)
when flags=1 type=65 "#{seq} WIFI_SET ok"
when flags=0 type=66 "#{seq} WIFI_FORGET slot {slot}" payload: slot:u8
when flags=1 type=66 "#{seq} WIFI_FORGET ok"

# anything else
when flags=0 "#{seq} {type:type} (request)"
when flags=1 "#{seq} {type:type} ok"
